# Copie ce fichier en .env puis remplis les valeurs

PORT=4000

# En local : mongodb://127.0.0.1:27017/portfolio
# En ligne : l'URL fournie par MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Une longue chaîne aléatoire (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-moi

# Tes identifiants admin
ADMIN_EMAIL=ton.email@exemple.com
# Génère le hash avec : npm run hash-password -- "TonMotDePasse"
# Garde les guillemets simples autour du hash
ADMIN_PASSWORD_HASH=''

# Adresse(s) du site autorisée(s) à appeler l'API, séparées par des virgules
CLIENT_ORIGIN=http://localhost:5173
